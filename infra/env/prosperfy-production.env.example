# Template ENV_FILE_WEB — producao Prosperfy
# Copie o conteudo (com valores reais) para:
#   GitHub -> Settings -> Environments -> production -> Secret ENV_FILE_WEB
# NAO commitar com segredos preenchidos.
#
# Host publico: agify.prosperfy.com.br
# Variable APP_HOST_FRONTEND no GitHub: agify.prosperfy.com.br (sem https)

# --- Supabase Cloud ---
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY>

# --- App (obrigatorio: mesmo host do Traefik) ---
NEXT_PUBLIC_APP_URL=https://agify.prosperfy.com.br

# --- Cloudinary ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<CLOUD_NAME>
CLOUDINARY_API_KEY=<API_KEY>
CLOUDINARY_API_SECRET=<API_SECRET>

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=<REDIS_REST_URL>
UPSTASH_REDIS_REST_TOKEN=<REDIS_REST_TOKEN>

# --- Resend ---
RESEND_API_KEY=<RESEND_KEY>
RESEND_FROM=Agify <noreply@prosperfy.com.br>

# --- Web Push (opcional) ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

NODE_ENV=production
